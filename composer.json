{
    "name": "pepiuox/php-grapesjs",
    "description": "PHP-based CMS that uses the GrapesJS Web Builder Framework, it also includes an access and registration system",
    "type": "web-builder",
    "keywords": [
        "Web builder",
        "framework",
        "GrapesJS",
        "bootstrap",
        "cms",
        "bootstrap cms",
        "Bootstrap CMS",
        "Bootstrap-CMS",
        "blog",
        "login",
        "login system",
        "grapes",
        "grapesjs",
        "Grapes JS",
        "wysiwyg",
        "web",
        "template",
        "editor",
        "newsletter",
        "site",
        "builder"
    ],
    "license": "MIT",
    "authors": [{
        "name": "Jose Mantilla",
        "email": "contact@pepiuox.net",
        "homepage": "https://pepiuox.net",
        "role": "Project Manager"
    }],
    "support": {},
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "v5.7.0",
        "phpmailer/phpmailer": "v7.1.1",
        "monolog/monolog": "3.12.1",
        "intervention/image": "4.3.4",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "vimeo/psalm": "6.17.2",
        "phpstan/phpstan": "2.2.14",
        "squizlabs/php_codesniffer": "4.0.4",
        "phpunit/phpunit": "13.3.4",
        "friendsofphp/php-cs-fixer": "v3.95.25"
    },
    "autoload": {
        "psr-4": {
            "PepiuoX\\": "core/src/"
        },
        "classmap": [
            "core/controller/"
        ],
        "files": [
            "core/Autoload.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/phpcs",
        "psalm": "vendor/bin/psalm",
        "phpstan": "vendor/bin/phpstan analyse",
        "all-checks": [
            "@cs-check",
            "@psalm",
            "@phpstan",
            "@test"
        ],
        "post-install-cmd": [
            "cp -n .env.example .env || true"
        ]
    },
    "repositories": []
}
